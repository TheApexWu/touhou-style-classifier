  "methods": {
    "clap": {
      "model": "laion/clap-htsat-unfused",
      "overall_accuracy": 0.57,
      "feature_dimension": 512,
      "extraction_time_per_sample": 0.14,
      "per_class": {
        "IOSYS": 0.45,
